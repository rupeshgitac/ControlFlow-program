		if (noOfPas > 6) { // if true then only below code gets executed.
			// Do not allow to book
			System.out.println("As per IRCTC policy, only 6 passengers are allowes per PNR");

		} else {
			pnr = "8956214874";
			System.out.println("Confirming the booking " + pnr);
			System.out.println("Status : confirmed");
			System.out.println("SEAT : 27 A1");

		}
		// if above condition is false then execution continuous.
		// ...
		return pnr;

	}
}
