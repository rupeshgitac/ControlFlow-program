package com.kodewala.control.flow1;

public class MmtDiscount {

	private static final double DISCOUNT_RATE_10_PERCENT = 0.10;
	private static final double DISCOUNT_RATE_15_PERCENT = 0.15;
	private static final double MAXIMUM_DISCOUNT = 1250;

	public double calculateDiscount(double fare) {

		double discount = 0;

		if (fare <= 5000) {

			// No discount
			discount = 0;

		} else if (fare <= 10000) {

			// 10% discount
			discount = fare * DISCOUNT_RATE_10_PERCENT;

		} else {

			// 15% discount
			discount = fare * DISCOUNT_RATE_15_PERCENT;
		}

		// Maximum discount cannot exceed 1250
		if (discount > MAXIMUM_DISCOUNT) {
			discount = MAXIMUM_DISCOUNT;
		}

		return discount;
	}
}
