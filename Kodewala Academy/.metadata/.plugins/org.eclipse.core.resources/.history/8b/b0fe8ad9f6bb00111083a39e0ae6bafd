package com.kodewala.control.flow1;

public class MakeMyTrip {

    public static void main(String[] args) {

        double fare = 8000;

        MakeMyTripDiscountService discountService =
                new MakeMyTripDiscountService();

        double discount = discountService.calculateDiscount(fare);

        double finalFare = fare - discount;

        System.out.println("Original Fare : " + fare);
        System.out.println("Discount      : " + discount);
        System.out.println("Final Fare    : " + finalFare);
    }
}
