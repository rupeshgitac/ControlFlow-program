package com.kodewala.scan;

import java.util.Scanner;

public class Driver {

	public static void main(String[] args) {

		Scanner sc = new Scanner(System.in); // Create(open) connection from console

		System.out.println("Enter the name : ");
		String name = sc.nextLine(); // Reading String input

		System.out.println("Enter the price : ");
		int price = sc.nextInt(); // reading line

		System.out.println("Name is : " + name);
		System.out.println("Name is : " + price);

		sc.close(); // close the connection

	}

}
